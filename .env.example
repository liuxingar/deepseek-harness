# DeepSeek Harness 群晖 NAS 环境变量配置
# 使用方法：复制本文件为 .env，然后填入你的配置

# 【必填】DeepSeek API Key，去 https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=sk-在这里填你的key

# 【可选】自定义模型接口地址（代理或自建 OpenAI 兼容模型时填写）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Web UI 端口（默认 3080）
DSH_PORT=3080

# 【必填】群晖的局域网 IP（浏览器访问 dsh 必须在此列表，否则 /api 被 403 拒绝）
# 多个地址用英文逗号分隔，例如 192.168.50.100,192.168.50.101
DSH_TRUSTED_HOSTS=192.168.50.100

# 【必填】agent 工作区目录 = 群晖上的真实文件夹路径
DSH_WORKSPACE=/volume1/docker/dsh/workspace

# 【必填】dsh 数据目录（配置/模型设置/API key/会话历史）= 群晖上的真实文件夹路径
# 容器内挂载到 /app/.dsh（即 DSH_HOME），挂错会导致配置丢失
DSH_DATA=/volume1/docker/dsh/data

# 权限/沙箱模式：群晖 NAS 无 bwrap/Landlock 沙箱后端，保持 danger-full-access 即可
# （workspace-write 会报 "no sandbox backend is usable"）
DSH_PERMISSION_MODE=danger-full-access
